# Sokoul local backend settings: the template start-backend.sh merges into
#   macOS:   ~/Library/Application Support/SokoulApi/local.env
# Only keys missing from local.env are added; values already there are never changed.
# Fill values in local.env (never in this file), then re-run API/start-backend.sh.
# No inline comments: Docker reads everything after '=' as the value.

# ===== Essential =====
# The Movie Database v3 API key (catalogue, artwork). Free: https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# ===== Debrid services (proxiesembed) =====
# Shown in this order; empty = none. Available: deepbrid,realdebrid,bestdebrid,debridr
DEBRID_ENABLED_PROVIDERS=
# https://real-debrid.com/apitoken
REAL_DEBRID_API_KEY=
DEEPBRID_API_KEY=
BESTDEBRID_API_KEY=
DEBRIDR_ACCOUNT_KEY=

# ===== IPTV (Mainapi live TV) =====
XTREAM_URL=
XTREAM_USER=
XTREAM_PASS=

# ===== Optional sources and extras =====
# TheIntroDB: intro/outro segments (AniSkip, SkipDB and IntroDB need no key)
THEINTRODB_API_KEY=
# SwiftFlow / NorthLive partner key: https://swiftflow.lol/partner_register.php
SWIFTFLOW_API_KEY=
# Uqload / XVideoSharing
UQLOAD_API_KEY=
# French-Stream account
FSTREAM_LOGIN_NAME=
FSTREAM_LOGIN_PASSWORD=
# france.tv account (proxiesembed)
FRANCETV_EMAIL=
FRANCETV_PASSWORD=
# OpenRouter (AI features)
OPENROUTER_API_KEY=

# ===== Browser access =====
# Extra browser origins allowed with credentials, comma separated (loopback is always allowed). Example: http://192.168.0.10:8088
SOKOUL_ALLOWED_ORIGINS=
# Site that opens the TV link code; empty = Mainapi's own origin
PUBLIC_SITE_URL=

# ===== Off for a personal setup =====
# No outgoing Discord reports, no payments, no Hydracker traffic, KissKH disabled.
MAINAPI_PROBE_SECONDS=0
MAINAPI_PROBE_DISCORD_ENABLED=false
SOURCE_REFRESH_WEBHOOK_ENABLED=false
EXTRACTION_FAILURE_WEBHOOK_ENABLED=false
WIFLIX_PROXY_BLOCK_WEBHOOK_ENABLED=false
WIFLIX_FREE_PROXY_ENABLED=false
HYDRACKER_BLACKOUT=true
HYDRACKER_LIVE_ENABLED=false
KISSKH_ENABLED=false
VIP_PAYGATE_ENABLED=false
VIP_PAYBLIS_ENABLED=false
VIP_CRYPTOGATE_ENABLED=false
MEDIA_SIGNATURE_TTL=43200
